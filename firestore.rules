rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A Player ID is a person's shareable identity across games and
    // devices. It maps to whichever device (auth uid) is currently using
    // it, which is what lets that person's own phone write to their game
    // index after a reinstall or a phone swap.
    //
    // Deliberately claimable by any signed-in user: knowing someone's ID
    // is enough to point your app at it. That's the documented trade-off
    // for having no accounts — and since only a game's host can write to
    // that game, the most it buys an impostor is spectating.
    match /playerIds/{playerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // "Which games am I in?" — written either by the person themselves
      // (hosting or joining) or by the host of the game they were added to.
      match /games/{gameCode} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && (request.auth.uid == get(/databases/$(database)/documents/playerIds/$(playerId)).data.uid
                         || (exists(/databases/$(database)/documents/games/$(gameCode))
                             && request.auth.uid == get(/databases/$(database)/documents/games/$(gameCode)).data.hostId));
      }
    }

    match /games/{gameCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;
      // Only the host can update the game doc (used to end the game).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.hostId;
      // Only the host can delete the game (used by the "Delete Game" cleanup
      // action, which removes players/activity first, then the game doc).
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.hostId;

      // A read-only, host-written record of what happened, for viewers who
      // can watch the numbers change live but never cause a change
      // themselves.
      match /activity/{entryId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/games/$(gameCode)).data.hostId;
        allow update: if false;
        // Only the host can delete entries, and only as part of Delete Game
        // cleanup (there's no per-entry delete UI).
        allow delete: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/games/$(gameCode)).data.hostId;
      }

      // Note: {playerDocId} is the *document key* for a seat at this table
      // (an auth uid for self-joiners, a generated "manual-…" id otherwise).
      // Not to be confused with the shareable Player ID above, which rides
      // along as a field on these docs.
      match /players/{playerDocId} {
        allow read: if request.auth != null;
        // You can join yourself, or the host can add anyone — including a
        // player without their own device, under a generated ID.
        allow create: if request.auth != null
                      && (request.auth.uid == playerDocId
                          || request.auth.uid == get(/databases/$(database)/documents/games/$(gameCode)).data.hostId);
        // Only the host records buy-ins, cash-outs, and corrections.
        allow update: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/games/$(gameCode)).data.hostId;
        // Only the host can remove a player. There's no additional
        // restriction beyond host-only here: the host can already edit or
        // zero out any buy-in/cash-out via update, so delete adds no risk
        // beyond what update already allows. (The "Delete Player" button
        // still only appears in the UI for empty placeholders — that's
        // accident prevention, not a security boundary. "Delete Game"
        // needs to remove every player regardless of buy-ins.)
        allow delete: if request.auth != null
                      && request.auth.uid == get(/databases/$(database)/documents/games/$(gameCode)).data.hostId;
      }
    }
  }
}
