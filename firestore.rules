rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;
      // Only the host can update the game doc (used to end the game).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.hostId;
      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;
        // You can only create your own player entry when you join.
        allow create: if request.auth != null && request.auth.uid == playerId;
        // Any signed-in participant can record buy-ins / cash-outs at the table
        // (one person is usually running the chip counts for the whole group).
        allow update: if request.auth != null;
        allow delete: if false;
      }
    }
  }
}
