rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;
      // Only the host can update the game doc (used to end the game).
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.hostId;
      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;
        // You can only create your own player entry when you join.
        allow create: if request.auth != null && request.auth.uid == playerId;
        // Any signed-in participant can record a new buy-in / first cash-out at the
        // table (one person is usually running the chip counts). Correcting an
        // already-recorded amount instead goes through editRequests below.
        allow update: if request.auth != null;
        allow delete: if false;
      }

      match /editRequests/{requestId} {
        allow read: if request.auth != null;
        // You can only file a request under your own name, and it starts pending.
        allow create: if request.auth != null
                      && request.resource.data.requestedBy == request.auth.uid
                      && request.resource.data.status == 'pending';
        // Resolving (accept/reject) requires a different player than whoever
        // filed it, and only while it's still pending.
        allow update: if request.auth != null
                      && resource.data.status == 'pending'
                      && request.auth.uid != resource.data.requestedBy;
        allow delete: if false;
      }
    }
  }
}
